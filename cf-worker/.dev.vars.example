# Copy this file to ".dev.vars" (gitignored, never commit) for local `wrangler dev` testing.
# Get a real key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_REAL_KEY_HERE

# Service account used ONLY to sign a Firebase custom token for the fixed uid
# 'access-log-worker' (BL-014 — Access Log). Download a key (Firebase Console → Project
# Settings → Service Accounts → Generate new private key — same place
# LSH/serviceAccountKey.json came from) and paste the ENTIRE JSON file contents as ONE line
# here. Unlike the earlier (superseded) design, the resulting credential does NOT bypass
# firestore.rules — it's exchanged for a normal ID token that can only do what
# LSH/firestore.rules grants to uid 'access-log-worker' (create on AccessLogs, nothing else).
# Still never commit this — a leaked key lets someone mint custom tokens for ANY uid, not just
# this one, so treat it as sensitive regardless.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"lsh-nammon","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SERVICE_ACCOUNT@lsh-nammon.iam.gserviceaccount.com"}

# Public Firebase Web API key (same value as wrangler.toml's [vars] — repeated here only so
# `wrangler dev` has it available locally too; not sensitive).
FIREBASE_WEB_API_KEY=AIzaSyCaCs4tLsRi2IA9sr4nyoWV2jDirxFjVcU
