rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isApprovedStudent() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.role == 'student' && profile.status == 'อนุมัติแล้ว';
    }

    function isApprovedCommunity() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.role == 'community' && profile.status == 'อนุมัติแล้ว';
    }

    match /users/{userId} {
      // "read" ครอบทั้ง get และ list — OR สุดท้ายเพิ่ม 2026-09-23 (BL-013 gap): เปิดให้ผู้ใช้ที่
      // login แล้วทุกบทบาท query หาบัญชีชุมชนที่ "อนุมัติแล้ว" เท่านั้นได้ (ใช้เติม dropdown
      // "เลือกชุมชนที่เกี่ยวข้อง" ใน student-publish.html) — client ต้อง where('role','==','community')
      // + where('status','==','อนุมัติแล้ว') ตรงกับเงื่อนไขนี้เป๊ะ query ถึงจะผ่าน (Firestore ต้อง
      // พิสูจน์ได้ทุก doc ที่จะคืนผ่านเงื่อนไขนี้เสมอ) ไม่เปิด field อื่น/สถานะอื่น (รออนุมัติ/ไม่อนุมัติ)
      // ให้เห็นเด็ดขาด และยังไม่เปิดให้อ่าน users doc ของ role อื่น (เช่น student คนอื่น) เพิ่มจากเดิม
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || getRole() == 'teacher'
                      || (resource.data.role == 'community' && resource.data.status == 'อนุมัติแล้ว'));
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role in ['student', 'community']
                    && request.resource.data.status == 'รออนุมัติ';
      allow update: if request.auth != null
                    && getRole() == 'teacher'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'approverId', 'approverName', 'rejectionReason']);
      allow delete: if false;
    }

    match /CommunityContent/{contentId} {
      allow read: if request.auth != null || resource.data.status == 'เผยแพร่แล้ว';
      allow create: if request.auth != null
                    && isApprovedCommunity()
                    && request.resource.data.communityId == request.auth.uid
                    && request.resource.data.status == 'เผยแพร่แล้ว';
      allow update: if request.auth != null
                    && getRole() == 'teacher'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['title', 'bodyTh', 'caption', 'updatedAt']);
      allow delete: if false;
    }

    match /ContentEditRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && isApprovedCommunity()
                    && request.resource.data.communityId == request.auth.uid
                    && request.resource.data.status == 'รอพิจารณา';
      allow update: if request.auth != null
                    && getRole() == 'teacher'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'approverId', 'approverName', 'rejectionReason']);
      allow delete: if false;
    }

    match /LSHRequests/{requestId} {
      // แก้ 2026-09-23 (เทสต์ความปลอดภัยพบ): เดิม `request.auth != null` เพียงเงื่อนไขเดียวเปิดให้
      // "ผู้ใช้ที่ login แล้วคนไหนก็ได้" (นิสิตคนอื่น, ชุมชน, นักท่องเที่ยว) อ่านผลงานที่ยัง
      // "รอพิจารณา"/"ไม่อนุมัติ" ของคนอื่นได้หมด ไม่ได้จำกัดว่าต้องเป็นเจ้าของหรือ role=teacher —
      // ยืนยันด้วย tests/security-cross-user-pending-work-blocked.spec.js ว่ารั่วจริงที่ชั้นสิทธิ์
      // (ไม่ใช่แค่ทดสอบผิด) แก้ให้แคบลงเหลือ: public อ่านได้เฉพาะที่อนุมัติแล้ว, ผู้ใช้ login อ่าน
      // ได้เฉพาะของตัวเอง (ให้เจ้าของเช็คสถานะ/เหตุผลไม่อนุมัติผลงานตัวเองได้ตามเดิม — BL-018) หรือ
      // role=teacher (ต้องเห็นทุกอันเพื่อตรวจ)
      allow read: if resource.data.status == 'อนุมัติ'
                  || (request.auth != null
                      && (resource.data.requesterId == request.auth.uid || getRole() == 'teacher'));
      allow create: if request.auth != null
                    && isApprovedStudent()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.status == 'รอพิจารณา';
      allow update: if request.auth != null && getRole() == 'teacher';
      allow delete: if false;
    }

    match /AiAssistLogs/{logId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.requesterId || getRole() == 'teacher');
      // เพิ่ม 2026-09-23 (Part 3 — AI backend proxy): เดิมจำกัดแค่นิสิต/อาจารย์ ตอนนี้ปุ่ม AI
      // มีให้ใช้ทั้งชุมชนและนักท่องเที่ยวด้วย (แปลภาษา/แคปชัน/SEO ฯลฯ) จึงเปิดให้ผู้ใช้ที่ login
      // แล้วทุกบทบาทบันทึก log การใช้งานของตัวเองได้ (ยังบังคับ requesterId ต้องตรงกับ uid ผู้เขียนเสมอ)
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /AiSummaries/{summaryId} {
      allow read: if request.auth != null && getRole() == 'teacher';
      allow create: if request.auth != null
                    && getRole() == 'teacher'
                    && request.resource.data.generatedBy == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /touristAccounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == 'tourist';
      allow update: if false;
      allow delete: if false;
    }

    match /Reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.touristId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /Bookmarks/{bookmarkId} {
      // Ownership is checked against the deterministic doc ID ({touristId}_{contentType}_{contentId})
      // rather than resource.data, because clients call getDoc() to check bookmark status BEFORE the
      // doc exists (not-yet-bookmarked) — referencing resource.data on a non-existent doc denies the read.
      allow read: if request.auth != null && bookmarkId.split('_')[0] == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.touristId == request.auth.uid
                    && bookmarkId == request.auth.uid + '_' + request.resource.data.contentType + '_' + request.resource.data.contentId;
      allow update: if false;
      allow delete: if request.auth != null && bookmarkId.split('_')[0] == request.auth.uid;
    }

    match /ConsentRecords/{recordId} {
      allow read: if false;
      allow create: if request.resource.data.analytics_consent == request.resource.data.marketing_consent
                    && (request.resource.data.user_account_id == null
                        || request.resource.data.user_account_id == request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /AccessLogs/{logId} {
      // เพิ่ม 2026-09-23 (Part 5 — BL-014), แก้ 2026-09-23 (จำกัดสิทธิ์แคบลง): เขียนได้เฉพาะ
      // uid คงที่ 'access-log-worker' เท่านั้น (Cloudflare Worker แลก Firebase custom token
      // เป็น ID token ของ uid นี้ก่อนเขียนเสมอ — ดู cf-worker/src/index.js) ผ่าน rule ปกติ
      // ไม่ได้ bypass เหมือนเดิม — uid นี้ไม่มีสิทธิ์อื่นเลยนอกจาก create ที่นี่ จึงต่อให้ Worker
      // secret หลุด ผลกระทบก็จำกัดอยู่แค่เขียน AccessLogs เท่านั้น ไม่ใช่เข้าถึงฐานข้อมูลทั้งหมด
      allow read: if request.auth != null && getRole() == 'teacher';
      allow create: if request.auth != null
                    && request.auth.uid == 'access-log-worker'
                    && request.resource.data.keys().hasOnly(
                         ['timestamp', 'ip_address', 'user_agent', 'action', 'user_account_id', 'expires_at']);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
