rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isApprovedStudent() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.role == 'student' && profile.status == 'อนุมัติแล้ว';
    }

    function isApprovedCommunity() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.role == 'community' && profile.status == 'อนุมัติแล้ว';
    }

    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || getRole() == 'teacher');
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role in ['student', 'community']
                    && request.resource.data.status == 'รออนุมัติ';
      allow update: if request.auth != null
                    && getRole() == 'teacher'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'approverId', 'approverName', 'rejectionReason']);
      allow delete: if false;
    }

    match /CommunityContent/{contentId} {
      allow read: if request.auth != null || resource.data.status == 'เผยแพร่แล้ว';
      allow create: if request.auth != null
                    && isApprovedCommunity()
                    && request.resource.data.communityId == request.auth.uid
                    && request.resource.data.status == 'เผยแพร่แล้ว';
      allow update: if request.auth != null
                    && getRole() == 'teacher'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['title', 'bodyTh', 'caption', 'updatedAt']);
      allow delete: if false;
    }

    match /ContentEditRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && isApprovedCommunity()
                    && request.resource.data.communityId == request.auth.uid
                    && request.resource.data.status == 'รอพิจารณา';
      allow update: if request.auth != null
                    && getRole() == 'teacher'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'approverId', 'approverName', 'rejectionReason']);
      allow delete: if false;
    }

    match /LSHRequests/{requestId} {
      allow read: if request.auth != null || resource.data.status == 'อนุมัติ';
      allow create: if request.auth != null
                    && isApprovedStudent()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.status == 'รอพิจารณา';
      allow update: if request.auth != null && getRole() == 'teacher';
      allow delete: if false;
    }

    match /AiAssistLogs/{logId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.requesterId || getRole() == 'teacher');
      // เพิ่ม 2026-09-23 (Part 3 — AI backend proxy): เดิมจำกัดแค่นิสิต/อาจารย์ ตอนนี้ปุ่ม AI
      // มีให้ใช้ทั้งชุมชนและนักท่องเที่ยวด้วย (แปลภาษา/แคปชัน/SEO ฯลฯ) จึงเปิดให้ผู้ใช้ที่ login
      // แล้วทุกบทบาทบันทึก log การใช้งานของตัวเองได้ (ยังบังคับ requesterId ต้องตรงกับ uid ผู้เขียนเสมอ)
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /AiSummaries/{summaryId} {
      allow read: if request.auth != null && getRole() == 'teacher';
      allow create: if request.auth != null
                    && getRole() == 'teacher'
                    && request.resource.data.generatedBy == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /touristAccounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == 'tourist';
      allow update: if false;
      allow delete: if false;
    }

    match /Reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.touristId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /Bookmarks/{bookmarkId} {
      // Ownership is checked against the deterministic doc ID ({touristId}_{contentType}_{contentId})
      // rather than resource.data, because clients call getDoc() to check bookmark status BEFORE the
      // doc exists (not-yet-bookmarked) — referencing resource.data on a non-existent doc denies the read.
      allow read: if request.auth != null && bookmarkId.split('_')[0] == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.touristId == request.auth.uid
                    && bookmarkId == request.auth.uid + '_' + request.resource.data.contentType + '_' + request.resource.data.contentId;
      allow update: if false;
      allow delete: if request.auth != null && bookmarkId.split('_')[0] == request.auth.uid;
    }

    match /ConsentRecords/{recordId} {
      allow read: if false;
      allow create: if request.resource.data.analytics_consent == request.resource.data.marketing_consent
                    && (request.resource.data.user_account_id == null
                        || request.resource.data.user_account_id == request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
