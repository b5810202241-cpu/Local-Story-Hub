.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/appearance.json
.obsidian/core-plugins.json

# Firebase CLI local deploy cache (not shared, regenerated automatically)
.firebase/

# Node dependencies + Playwright test output (regenerated, not shared)
node_modules/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Firebase web config with real apiKey — keep local, use firebase-config.example.js as template
docs/02-design/01-prototypes/prototype-v2/firebase-config.js

# OpenRouter API key (real secret, never commit) — keep local, use ai-test-config.example.js as template
LSH/ai-test-config.js

# ai-assist-config.js used to hold a real OpenRouter API key (client-side secret) — since
# the Part 3 AI-proxy migration (2026-09-23) it only holds the public Cloudflare Worker URL,
# which is NOT sensitive, so it's committed and deployed normally now (see cf-worker/README.md).
